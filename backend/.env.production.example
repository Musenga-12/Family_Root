# Production settings for the family server. Copy the values into your host's environment variables (or a .env file
# on the server that is never committed). Every value below is a placeholder: replace all of them.

# Turns on the start-up safety checks and hides /docs. The server refuses to start with sample secrets, localhost or
# non-https addresses, a SQLite database, or a database that isn't at the latest migration (alembic upgrade head).
ENVIRONMENT=production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"   Changing it signs everyone out.
SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL only (a SQLite file is refused: hosts wipe the disk on redeploys).
# Supabase: Project settings → Database → Connection string (Session pooler), with the driver set to psycopg.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# The web app's public address: exactly https://host, no path, no trailing slash, no wildcard. Only these origins may
# call the API from a browser. EXTRA_ORIGINS adds more, comma-separated, under the same rules.
FRONTEND_ORIGIN=https://your-familyroots-site.example
# EXTRA_ORIGINS=https://www.your-familyroots-site.example

# This API's own public address (used to build photo and audio links).
API_BASE_URL=https://api.your-familyroots-site.example

ACCESS_TOKEN_MINUTES=1440
FILE_LINK_MINUTES=720
MAX_IMAGE_MB=10
MAX_AUDIO_MB=50
RATE_LIMIT_ENABLED=true
# How many proxies of the host sit in front of the server and add the visitor's address to X-Forwarded-For, so
# sign-in attempts are counted per visitor. Start with 1 on Render, then confirm it after the first deploy with
# scripts/check_client_ip.py (DEPLOY.md → Visitor addresses behind a proxy). 0 = no proxy.
TRUSTED_PROXY_HOPS=1

# Uploaded photos, recordings and scans. Recommended: a private Supabase Storage bucket, so files survive redeploys.
# Create the bucket in Supabase → Storage → New bucket, name below, "Public bucket" OFF.
STORAGE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project settings → API → service_role key. Server-side only: never put it in the web app or commit it.
SUPABASE_SERVICE_KEY=replace-with-the-service-role-key
SUPABASE_BUCKET=family-files
# Or keep files on the server's disk, which must then be a persistent disk:
# STORAGE=local
# UPLOAD_DIR=/var/data/familyroots-uploads

# Email (password resets, invitations, welcome and "password changed" notes): see DEPLOY.md → Email.
# Server-side only: never put these in the web app's VITE_ variables.
#
# A) No domain bought yet (state "production-not-configured"): leave EMAIL_PROVIDER, RESEND_API_KEY and EMAIL_FROM
#    unset. Nothing claims an email was sent: "Forgot password" points people to an Admin-made reset link, and
#    invitations are shared by link. Resend's test mode (onboarding@resend.dev) is NOT used here: it can't reach
#    real people.
#
# B) With a domain verified in Resend (state "production-configured"):
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=replace-with-your-resend-api-key
# EMAIL_FROM=FamilyRoots <no-reply@mail.your-familyroots-site.example>
# EMAIL_REPLY_TO=help@your-familyroots-site.example
#
# C) Or any SMTP service you are allowed to send through (also "production-configured"):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.your-mail-service.example
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
# EMAIL_FROM=FamilyRoots <the-address-that-account-may-send-as@example>
EMAIL_TIMEOUT_SECONDS=10
EMAIL_MIN_RESPONSE_MS=1500
