# Copy this file to .env and change the values. Never commit .env.
# production = start-up safety checks, no /docs (see README).
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./familyroots.db
FRONTEND_ORIGIN=http://localhost:5174
# Other addresses the app is opened from, comma-separated (127.0.0.1 is allowed automatically), e.g. npm run preview:
# EXTRA_ORIGINS=http://localhost:4173
# Proxies of your own in front of this server (0 on your own computer). See DEPLOY.md → Visitor addresses behind a proxy.
TRUSTED_PROXY_HOPS=0
ACCESS_TOKEN_MINUTES=1440
API_BASE_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_IMAGE_MB=10
MAX_AUDIO_MB=50
# Where uploads are kept: local (UPLOAD_DIR) or supabase (a private bucket). See .env.production.example.
STORAGE=local
# Email on your own computer (state "development": nothing reaches a real inbox). Pick one:
#  - empty: messages, including reset links, are written to the server console
#  - Mailpit (https://mailpit.axllent.org): run it, then open http://localhost:8025 to read every message
#      EMAIL_PROVIDER=smtp
#      SMTP_HOST=localhost
#      SMTP_PORT=1025
#  - Resend's test mode, to check the Resend integration without a domain (messages go to Resend's test inbox only):
#      EMAIL_PROVIDER=resend-test
#      RESEND_API_KEY=re_your_test_key
#      EMAIL_TEST_RECIPIENT=delivered@resend.dev
EMAIL_PROVIDER=
