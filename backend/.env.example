# Copy this file to .env and change the values. Never commit .env.
# production = start-up safety checks, no /docs (see README).
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./familyroots.db
FRONTEND_ORIGIN=http://localhost:5174
# Other addresses the app is opened from, comma-separated (127.0.0.1 is allowed automatically), e.g. npm run preview:
# EXTRA_ORIGINS=http://localhost:4173
ACCESS_TOKEN_MINUTES=1440
API_BASE_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_IMAGE_MB=10
MAX_AUDIO_MB=50
# Where uploads are kept: local (UPLOAD_DIR) or supabase (a private bucket). See .env.production.example.
STORAGE=local
