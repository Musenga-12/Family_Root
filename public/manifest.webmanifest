{
  "name": "FamilyRoots – Living Archive",
  "short_name": "FamilyRoots",
  "description": "A private archive for your family's tree, photos, stories and records.",
  "start_url": "./#/overview",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fcf5ee",
  "theme_color": "#c2410c",
  "categories": ["lifestyle", "social"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Add a memory", "url": "./#/memories", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Record a story", "url": "./#/stories?record=1", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Messages", "url": "./#/messages", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
